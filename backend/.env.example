# ============================================
# Panenku Backend - Environment Variables
# Salin file ini menjadi .env dan isi nilai asli
# JANGAN commit file .env ke GitHub!
# ============================================

# Server
SERVER_PORT=8080

# Database PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/panenku
DB_USER=panenku
DB_PASSWORD=password_kamu_disini

# JWT
JWT_SECRET=rahasia_jwt_yang_panjang_dan_acak
JWT_EXPIRATION=86400000

# MinIO / S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=panenku-files