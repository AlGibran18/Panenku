# Docker Compose reads .env. For bootRun, export these values in your shell too.
DB_URL=jdbc:postgresql://localhost:5432/panenku
DB_USER=panenku
DB_PASSWORD=replace-with-local-database-password
# At least 32 UTF-8 bytes; replace locally, never commit the actual secret.
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=panenku
SERVER_PORT=8080
